/* OpenDepot — desktop workspace theme */

QMainWindow { background: #f4f6f9; }

QWidget {
    color: #162033;
    font-family: "Segoe UI Variable Text", "Segoe UI", sans-serif;
    font-size: 13px;
}

QWidget#contentRoot, QStackedWidget { background: #f4f6f9; }

/* ---------- Sidebar ---------- */

QWidget#treePanel {
    background: #0d1728;
    border: none;
    border-right: 1px solid #1c2a40;
}

QLabel#brandMark {
    background: #2563eb;
    color: #ffffff;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 800;
}

QLabel#brand {
    color: #f8fafc;
    font-size: 18px;
    font-weight: 700;
}

QLabel#brandSub {
    color: #64748b;
    font-size: 9px;
    font-weight: 700;
}

QFrame#sidebarDivider {
    color: #1e2c42;
    background: #1e2c42;
    border: none;
    max-height: 1px;
}

QLabel#treeHeading {
    color: #64748b;
    font-size: 10px;
    font-weight: 700;
    padding: 8px 6px 2px 6px;
}

QTreeWidget {
    background: transparent;
    border: none;
    outline: 0;
    color: #cbd5e1;
}

QTreeWidget::item {
    padding: 6px 5px;
    border-radius: 6px;
    color: #cbd5e1;
}

QTreeWidget::item:hover { background: #16243a; color: #f8fafc; }
QTreeWidget::item:selected {
    background: #1d4ed8;
    color: #ffffff;
}

QWidget#treePanel QPushButton {
    background: #142137;
    border: 1px solid #21324c;
    color: #cbd5e1;
    padding: 5px 8px;
    font-size: 11px;
}

QWidget#treePanel QPushButton:hover {
    background: #1a2b45;
    border-color: #2f4668;
    color: #ffffff;
}

/* ---------- Typography ---------- */

QLabel#pageTitle {
    color: #0b1324;
    font-size: 26px;
    font-weight: 700;
}

QLabel#muted { color: #6b778c; }
QLabel#sectionTitle {
    color: #33415c;
    font-size: 13px;
    font-weight: 700;
    padding-top: 4px;
}

QLabel#cardCaption {
    color: #8a95a8;
    font-size: 10px;
    font-weight: 700;
}

QLabel#cardValue {
    color: #0b1324;
    font-size: 16px;
    font-weight: 600;
}

QLabel#chip {
    background: #eaf1ff;
    color: #1d4ed8;
    border: 1px solid #d4e2ff;
    border-radius: 11px;
    padding: 4px 11px;
    font-size: 11px;
    font-weight: 600;
}

/* ---------- Cards ---------- */

QFrame#card {
    background: #ffffff;
    border: 1px solid #e3e8f0;
    border-radius: 12px;
}

/* ---------- Actions ---------- */

QPushButton {
    background: #ffffff;
    border: 1px solid #d5dce8;
    border-radius: 7px;
    padding: 7px 14px;
    color: #1c2940;
    font-weight: 500;
}

QPushButton:hover { background: #f4f7fb; border-color: #bfc9da; }
QPushButton:pressed { background: #e9eef6; }
QPushButton:focus { border-color: #2563eb; }
QPushButton:disabled { color: #98a2b3; background: #f5f7fa; border-color: #e4e9f1; }

QPushButton#accent {
    background: #2563eb;
    border: 1px solid #2563eb;
    color: #ffffff;
    font-weight: 600;
    padding: 8px 16px;
}
QPushButton#accent:hover { background: #1d4ed8; border-color: #1d4ed8; }
QPushButton#accent:pressed { background: #1e40af; }

QPushButton#small { padding: 5px 10px; font-size: 12px; }
QPushButton#link {
    border: none;
    background: transparent;
    color: #2563eb;
    padding: 3px 0;
    text-align: left;
    font-weight: 500;
}
QPushButton#link:hover { color: #1d4ed8; text-decoration: underline; }

/* ---------- Menus and toolbar ---------- */

QMenuBar {
    background: #ffffff;
    border-bottom: 1px solid #e1e6ef;
    padding: 2px 6px;
}
QMenuBar::item { padding: 6px 11px; background: transparent; border-radius: 5px; }
QMenuBar::item:selected { background: #eef3fb; color: #1d4ed8; }

QMenu {
    background: #ffffff;
    border: 1px solid #dde3ed;
    padding: 5px;
}
QMenu::item { padding: 7px 26px 7px 22px; border-radius: 5px; }
QMenu::item:selected { background: #eef3fb; color: #1d4ed8; }
QMenu::separator { height: 1px; background: #e8edf4; margin: 5px 8px; }

QToolBar {
    background: #ffffff;
    border-bottom: 1px solid #e1e6ef;
    spacing: 4px;
    padding: 6px 10px;
}
QToolBar::separator { background: #e1e6ef; width: 1px; margin: 5px 7px; }
QToolBar QToolButton {
    padding: 7px 11px;
    border-radius: 6px;
    color: #33415c;
}
QToolBar QToolButton:hover { background: #eef3fb; color: #1d4ed8; }

/* ---------- Inputs ---------- */

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QComboBox {
    background: #ffffff;
    border: 1px solid #d8dfea;
    border-radius: 7px;
    padding: 6px 9px;
    color: #162033;
    selection-background-color: #cfe0ff;
    selection-color: #0b1324;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QSpinBox:focus, QComboBox:focus { border-color: #2563eb; }

QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #dde3ed;
    selection-background-color: #eef3fb;
    selection-color: #1d4ed8;
    outline: 0;
}

QCheckBox { spacing: 7px; color: #26334a; }
QGroupBox {
    border: 1px solid #e3e8f0;
    border-radius: 10px;
    margin-top: 14px;
    padding: 14px 12px 10px 12px;
    background: #ffffff;
    font-weight: 600;
    color: #33415c;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
    color: #64748b;
}

/* ---------- Tables ---------- */

QTableWidget {
    background: #ffffff;
    alternate-background-color: #fafbfd;
    border: 1px solid #e1e6ef;
    border-radius: 9px;
    gridline-color: #eef2f7;
    color: #1c2940;
    selection-background-color: #e8f0ff;
    selection-color: #0b1324;
    outline: 0;
}

QTableWidget::item { padding: 5px 7px; }
QTableWidget::item:selected { background: #e8f0ff; color: #0b1324; }

QHeaderView::section {
    background: #f7f9fc;
    color: #65718a;
    border: none;
    border-bottom: 1px solid #e1e6ef;
    padding: 8px 7px;
    font-size: 11px;
    font-weight: 700;
}
QTableCornerButton::section { background: #f7f9fc; border: none; }

/* ---------- Tabs ---------- */

QTabWidget::pane {
    border: 1px solid #e1e6ef;
    border-radius: 9px;
    background: #ffffff;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #66738a;
    padding: 8px 15px;
    margin-right: 2px;
    border-bottom: 2px solid transparent;
    font-weight: 500;
}
QTabBar::tab:hover { color: #1d4ed8; }
QTabBar::tab:selected { color: #1d4ed8; border-bottom-color: #2563eb; }

/* ---------- Scrollbars ---------- */

QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { background: transparent; width: 11px; margin: 2px; }
QScrollBar::handle:vertical {
    background: #c4cede;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #a9b6ca; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QScrollBar:horizontal { background: transparent; height: 11px; margin: 2px; }
QScrollBar::handle:horizontal {
    background: #c4cede;
    border-radius: 4px;
    min-width: 30px;
}

/* ---------- Status ---------- */

QStatusBar {
    background: #ffffff;
    border-top: 1px solid #e1e6ef;
    color: #69758a;
    padding: 2px 8px;
}
QStatusBar::item { border: none; }

QProgressBar {
    border: 1px solid #d8dfea;
    border-radius: 6px;
    text-align: center;
    background: #ffffff;
}
QProgressBar::chunk { background: #2563eb; border-radius: 5px; }

/* CPS segmented tabs */

QPushButton#cpsTab {
    border: 1px solid #d8dfea;
    border-right: none;
    border-radius: 0;
    background: #f7f9fc;
    padding: 6px 11px;
    color: #526077;
    font-weight: 500;
}
QPushButton#cpsTab:hover { background: #eef3fb; color: #1d4ed8; }
QPushButton#cpsTab:checked {
    background: #0d1728;
    color: #ffffff;
    border-color: #0d1728;
}
